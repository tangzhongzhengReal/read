[Unit]
Description=Read learning notes
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=/var/lib/read/app
Environment=NODE_ENV=production
Environment=PORT=3210
Environment=HOSTNAME=127.0.0.1
Environment=READ_DATA_DIR=/var/lib/read/data
Environment=READ_UPLOADS_DIR=/var/lib/read/uploads
ExecStart=__NODE__ /var/lib/read/app/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
